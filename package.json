{
  "name": "tagspot-ai-hub",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "api",
    "server",
    "ui"
  ],
  "scripts": {
    "setup": "npm install && node node_modules/electron/install.js",
    "dev": "npm run dev -w @tagspot/ui",
    "start": "npm run build && npm run start -w @tagspot/ui",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:e2e",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e -w @tagspot/ui",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "postinstall": "npm run generate -w @tagspot/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
